<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Allow access to your camera to take photos for editing and collages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Allow access to your photo library to pick images for editing and collages.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Allow access to save your edited photos and collages to your photo library.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The template server is plain HTTP on an IP address; allow cleartext to reach it. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>